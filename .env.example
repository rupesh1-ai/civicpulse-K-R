# Copy this file to .env and fill in real values.
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
# Keep demo mode true until you configure Twilio. In demo mode no SMS is sent.
DEMO_MODE=true

# Real SMS OTP via Twilio Verify:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional AI assistant (server-side only; never put this key in public JS):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
